<Window x:Class="WpfAntilopeFietsen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAntilopeFietsen"
        mc:Ignorable="d"
        Title="WpfAntiLopeFietsen" Height="450" Width="800">
    <Grid>
        <Label Content="Model:" Padding="0" HorizontalAlignment="Left" Margin="430,30,0,0" VerticalAlignment="Top"/>
        <ComboBox HorizontalAlignment="Left" Margin="520,30,0,0" VerticalAlignment="Top" Width="220">
            <ComboBoxItem IsSelected="True" x:Name="cmbCargo" Content="Antilope Cargo Dames (€ 1.339)" />
            <ComboBoxItem  x:Name="cmbTrans" Content="Antilope Transport Heren (€ 1.349)" />
            <ComboBoxItem x:Name="cmbElek" Content="Antilope Elektrisch (€ 2.299)" />
        </ComboBox>
        <Label Content="Accu:" Padding="0" HorizontalAlignment="Left" Margin="430,70,0,0" VerticalAlignment="Top"/>
        <RadioButton x:Name="rdoStandaard" Content="standaard (+ € 0,00)" GroupName="grpAccu" HorizontalAlignment="Left" Margin="520,70,0,0" VerticalAlignment="Top"/>
        <RadioButton x:Name="rdoGroot" Content="groot (+ € 50,00)" GroupName="grpAccu" HorizontalAlignment="Left" Margin="520,90,0,0" VerticalAlignment="Top"/>
        <Label Content="Accessoires:" Padding="0" HorizontalAlignment="Left" Margin="430,120,0,0" VerticalAlignment="Top"/>
        <CheckBox x:Name="chxBel" Content="Bel (+ € 25,00)" HorizontalAlignment="Left" Margin="520,120,0,0" VerticalAlignment="Top" />
        <CheckBox x:Name="chxZacht" Content="Zacht zadel (+ € 30,00)" HorizontalAlignment="Left" Margin="520,140,0,0" VerticalAlignment="Top"/>
        <CheckBox x:Name="chxBagage" Content="Bagagedrager (+ € 50,00)" HorizontalAlignment="Left" Margin="520,160,0,0" VerticalAlignment="Top" />
        <Button x:Name="btnPrijs" Content="Bereken prijs" Padding="8,3" HorizontalAlignment="Left" Margin="525,200,0,0" VerticalAlignment="Top" Click="BtnPrijs_Click" />
        <TextBlock HorizontalAlignment="Left" Margin="529,288,0,0" TextWrapping="Wrap" Text="onze prijs: -" FontSize="14" VerticalAlignment="Top" FontWeight="Bold"/>
        <TextBlock x:Name="txtPrijs" HorizontalAlignment="Left" Margin="614,288,0,0" TextWrapping="Wrap" Text="" FontSize="14" VerticalAlignment="Top" FontWeight="Bold"/>
        <Label Content="selecteer een plan voor de prijs per maand" HorizontalAlignment="Left" Margin="529,312,0,0" VerticalAlignment="Top"/>
        <Label Content="afbetaltingsplan: " HorizontalAlignment="Left" Margin="529,343,0,0" VerticalAlignment="Top"/>
        <ComboBox HorizontalAlignment="Left" Margin="635,353,0,0" VerticalAlignment="Top" Width="112">
            <ComboBoxItem Content="in één keer" />
            <ComboBoxItem Content="op 1 jaar" />
            <ComboBoxItem Content="op 2 jaar" />
            <ComboBoxItem Content="op 3 jaar" />

        </ComboBox>
        <Image x:Name="imgFiets1" Source="img/fiets1.jpg" HorizontalAlignment="Left" Height="308" Margin="49,52,0,0" VerticalAlignment="Top" Width="312"/>
        <Image x:Name="imgFiets2" Source="/img/fiets2.jpg" HorizontalAlignment="Left" Height="308" Margin="49,52,0,0" VerticalAlignment="Top" Width="312"/>
        <Image x:Name="imgFiets3" Source="/img/fiets3.jpg" HorizontalAlignment="Left" Height="308" Margin="49,52,0,0" VerticalAlignment="Top" Width="312"/>
    </Grid>
</Window>
