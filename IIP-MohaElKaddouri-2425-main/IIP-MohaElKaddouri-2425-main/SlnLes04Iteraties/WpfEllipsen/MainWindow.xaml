<Window x:Class="WpfEllipsen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ellipsen Generator" Height="500" Width="800">
    <Grid>
        <Canvas x:Name="canvas1" HorizontalAlignment="Left" Height="300" Margin="10,150,0,0" VerticalAlignment="Top" Width="770"/>
        <Label Content="Aantal Ellipsen:" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontSize="14"/>
        <Slider x:Name="sliderAantal" Minimum="1" Maximum="100" Value="50" HorizontalAlignment="Left" Width="300" Margin="150,10,0,0" VerticalAlignment="Top"/>
        <Label x:Name="lblAantal" Content="50" HorizontalAlignment="Left" Margin="470,10,0,0" VerticalAlignment="Top" FontSize="14"/>
        <Label Content="Minimum Radius:" HorizontalAlignment="Left" Margin="10,50,0,0" VerticalAlignment="Top" FontSize="14"/>
        <Slider x:Name="sliderMinRadius" Minimum="5" Maximum="50" Value="20" HorizontalAlignment="Left" Width="300" Margin="150,50,0,0" VerticalAlignment="Top"/>
        <Label x:Name="lblMinRadius" Content="20" HorizontalAlignment="Left" Margin="470,50,0,0" VerticalAlignment="Top" FontSize="14"/>
        <Label Content="Maximum Radius:" HorizontalAlignment="Left" Margin="10,90,0,0" VerticalAlignment="Top" FontSize="14"/>
        <Slider x:Name="sliderMaxRadius" Minimum="50" Maximum="200" Value="100" HorizontalAlignment="Left" Width="300" Margin="150,90,0,0" VerticalAlignment="Top"/>
        <Label x:Name="lblMaxRadius" Content="100" HorizontalAlignment="Left" Margin="470,90,0,0" VerticalAlignment="Top" FontSize="14"/>
        <TextBlock x:Name="txtError" Text="" Foreground="Red" HorizontalAlignment="Left" Margin="10,120,0,0" VerticalAlignment="Top" FontSize="14"/>
        <Button x:Name="btnTekenen" Content="TEKENEN" FontSize="18" HorizontalAlignment="Left" Margin="620,40,0,0" VerticalAlignment="Top" Height="40" Width="150" Click="BtnTekenen_Click"/>
    </Grid>
</Window>
