<Window x:Class="WpfHalloWereld.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfHalloWereld"
        mc:Ignorable="d"
        Title="WpfHalloWereld" Height="450" Width="800">
    <Grid Background="Beige">
        <TextBlock x:Name="txtHello" Text="Hallo! Hoe is je naam?" FontSize="16" HorizontalAlignment="Left" Margin="40,40,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="193"/>
        <TextBox x:Name="inpNaam" Text="" Padding="5" Width="125" HorizontalAlignment="Left" Margin="40,111,0,0" TextWrapping="Wrap" VerticalAlignment="Top" />
        <Button x:Name="btnOk" Content="OK" Padding="10,5" Click="btnOk_Click" HorizontalAlignment="Left" Margin="214,111,0,0" VerticalAlignment="Top" Width="81"/>
        <Button x:Name="btnReset" Content="HERSTEL" Padding="10,5" Click="btnReset_Click" HorizontalAlignment="Left" Margin="368,111,0,0" VerticalAlignment="Top" Width="81"/>

    </Grid>
</Window>
