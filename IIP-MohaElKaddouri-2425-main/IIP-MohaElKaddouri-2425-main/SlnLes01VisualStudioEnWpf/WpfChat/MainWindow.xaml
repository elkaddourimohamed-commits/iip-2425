<Window x:Class="WpfChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfChat"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="#FFA0EEE6">
        <Label x:Name="txtNaam" Content="Naam :" HorizontalAlignment="Left" Margin="178,58,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="inpNaam" HorizontalAlignment="Left" Margin="250,60,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="240"/>
        <Label x:Name="txtBericht" Content="Bericht :" HorizontalAlignment="Left" Margin="180,110,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="inpBericht" HorizontalAlignment="Left" Margin="250,115,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="240" Padding="20" Height="154"/>
        <TextBlock x:Name="txtChat" HorizontalAlignment="Left" Padding="20" Margin="514,48,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="260" Background="#FFFCF8F8" OpacityMask="#FF0B0A0A" Foreground="#FF111111" Height="341"/>
        <Button x:Name="btnVerzend" Content="VERZENDEN" HorizontalAlignment="Left" Margin="420,285,0,0" VerticalAlignment="Top" Width="75" Click="btnVerzend_Click" Padding="4"/>
    </Grid>
</Window>
