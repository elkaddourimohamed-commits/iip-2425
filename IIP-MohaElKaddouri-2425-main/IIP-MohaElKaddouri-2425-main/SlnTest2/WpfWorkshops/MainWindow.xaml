<Window x:Class="WpfWorkshops.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfWorkshops"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Label Content="Naam:" HorizontalAlignment="Left" Margin="63,24,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="inpNaam" HorizontalAlignment="Left" Margin="146,28,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="187" RenderTransformOrigin="0.432,1.584"/>
        <Label Content="Aantal:" HorizontalAlignment="Left" Margin="63,71,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="cmbAantal" HorizontalAlignment="Left" Margin="146,73,0,0" VerticalAlignment="Top" Width="84"/>
        <Label Content="Workshop:" HorizontalAlignment="Left" Margin="63,116,0,0" VerticalAlignment="Top"/>
        <ComboBox Name="cmbWorkshop" HorizontalAlignment="Left" Margin="146,120,0,0" VerticalAlignment="Top" Width="167"/>
        <Button x:Name="btnBevestigen" Content="Bevestigen" HorizontalAlignment="Left" Margin="240,164,0,0" VerticalAlignment="Top" Width="73" Height="26" Click="BtnBevestigen_Click"/>
        <Label Content="Overzicht bezettingen" HorizontalAlignment="Left" Margin="63,236,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <Label Content="Overzicht reservaties" HorizontalAlignment="Left" Margin="461,19,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <ListBox x:Name="lstReservaties" Margin="461,68,33,67"/>
        <ListBox x:Name="lstBezetingen" Margin="32,262,457,58"/>


    </Grid>
</Window>
