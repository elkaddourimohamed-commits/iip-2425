<Window x:Class="WpfPaswoordChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfPaswoordChecker"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Label  Content="Wachtwoord:" FontSize="18" HorizontalAlignment="Left" Margin="110,30,0,0" VerticalAlignment="Top" Height="40" Width="117"/>
        <TextBox x:Name="txtPasw" FontSize="18" HorizontalAlignment="Left" Margin="254,30,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="226" Height="37" TextChanged="txtPasw_TextChanged"/>
        <TextBlock x:Name="txtAcht" FontSize="16" HorizontalAlignment="Left" Margin="264,87,0,0" TextWrapping="Wrap" Text="minimum 8 karakters lang" VerticalAlignment="Top"/>
        <TextBlock x:Name="txtKlein" FontSize="16" HorizontalAlignment="Left" Margin="264,113,0,0" TextWrapping="Wrap" Text="minimum één kleine letter" VerticalAlignment="Top"/>
        <TextBlock x:Name="txtGroot" FontSize="16" HorizontalAlignment="Left" Margin="265,139,0,0" TextWrapping="Wrap" Text="minimum één hoofdletter" VerticalAlignment="Top"/>
        <TextBlock x:Name="txtCijfer" FontSize="16" HorizontalAlignment="Left" Margin="263,165,0,0" TextWrapping="Wrap" Text="minimum één cijfer" VerticalAlignment="Top"/>
        <TextBlock x:Name="txtVreemd" FontSize="16" HorizontalAlignment="Left" Margin="263,191,0,0" TextWrapping="Wrap" Text="minimum één vreemd karakter" VerticalAlignment="Top"/>
        <Button x:Name="BtnControleer" FontSize="18" Content="Controleer" HorizontalAlignment="Left" Margin="579,286,0,0" VerticalAlignment="Top" Height="63" Width="135" Click="BtnControleer_Click"/>
        <Label FontSize="18" Content="Sterkte: " HorizontalAlignment="Left" Margin="110,303,0,0" VerticalAlignment="Top"/>
        <TextBlock x:Name="txtSterkte" FontSize="18" HorizontalAlignment="Left" Margin="203,303,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" RenderTransformOrigin="-0.107,-0.016" Width="164" Height="34"/>
        <Rectangle x:Name="rctSterkte" HorizontalAlignment="Left" Height="36" Margin="110,356,0,0" Stroke="Black" VerticalAlignment="Top" Width="184"/>


    </Grid>
</Window>
