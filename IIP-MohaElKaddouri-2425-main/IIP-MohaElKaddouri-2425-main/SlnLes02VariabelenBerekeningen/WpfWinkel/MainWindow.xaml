<Window x:Class="WpfWinkel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfWinkel"
        mc:Ignorable="d"
        Title="WpfWinkel" Height="450" Width="800">
    <Grid>
        <TextBlock x:Name="txtPrijs1" HorizontalAlignment="Left" Margin="303,71,0,0" TextWrapping="Wrap" Text="2,2 euro" VerticalAlignment="Top" Height="33" Width="76" FontWeight="Bold" FontSize="14"/>
        <TextBlock x:Name="txtPrijs2" HorizontalAlignment="Left" Margin="303,156,0,0" TextWrapping="Wrap" Text="3,05 euro" VerticalAlignment="Top" Height="33" Width="76" FontWeight="Bold" FontSize="14"/>
        <TextBlock x:Name="txtPrijs3" HorizontalAlignment="Left" Margin="303,239,0,0" TextWrapping="Wrap" Text="2,75 euro" VerticalAlignment="Top" Height="33" Width="76" FontWeight="Bold" FontSize="14"/>
        <Button x:Name="btnOpt1" Click="BtnOpt1_Click" Content="+" HorizontalAlignment="Left" Margin="440,64,0,0" VerticalAlignment="Top" FontSize="18" Height="33" Width="34"/>
        <Button x:Name="btnOpt2" Click="BtnOpt2_Click" Content="+" HorizontalAlignment="Left" Margin="440,156,0,0" VerticalAlignment="Top" FontSize="18" Height="33" Width="34"/>
        <Button x:Name="btnOpt3" Click="BtnOpt3_Click" Content="+" HorizontalAlignment="Left" Margin="440,239,0,0" VerticalAlignment="Top" FontSize="18" Height="33" Width="34"/>
        <ListBox x:Name="lstBox" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="517,10,23,120"/>
        <TextBox x:Name="txtStock1" HorizontalAlignment="Left" Height="23" Margin="303,97,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="55"/>
        <TextBox x:Name="txtStock2" HorizontalAlignment="Left" Height="23" Margin="303,189,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="55"/>
        <TextBox x:Name="txtStock3" HorizontalAlignment="Left" Height="23" Margin="303,277,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="55"/>
        <Button x:Name="btnAfrekenen" Content="Afrekenen" HorizontalAlignment="Left" Margin="491,350,0,0" VerticalAlignment="Top" Width="120" Height="40" Click="BtnAfrekenen_Click"/>
        <Button x:Name="btnHerstartWinkel" Content="Herstart winkel" HorizontalAlignment="Left" Margin="627,350,0,0" VerticalAlignment="Top" Width="150" Height="40" Click="BtnHerstartWinkel_Click"/>
        <TextBlock x:Name="txtTotaal" HorizontalAlignment="Left" Margin="702,319,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" FontWeight="Bold" FontSize="14"/>
        <Image Source="img/banane.jpg" HorizontalAlignment="Left" Height="99" Margin="105,44,0,0" VerticalAlignment="Top" Width="105"/>
        <Image Source="img/boter.jpg" HorizontalAlignment="Left" Height="99" Margin="105,156,0,0" VerticalAlignment="Top" Width="105"/>
        <Image Source="img/eieren.webp" HorizontalAlignment="Left" Height="99" Margin="105,277,0,0" VerticalAlignment="Top" Width="105"/>
    </Grid>
</Window>