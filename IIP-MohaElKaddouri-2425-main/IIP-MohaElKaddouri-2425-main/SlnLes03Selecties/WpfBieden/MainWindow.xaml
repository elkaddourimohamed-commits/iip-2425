<Window x:Class="WpfBieden.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfBieden"
        mc:Ignorable="d"
        Title="WpfBieden" Height="450" Width="800">
    <Grid>
        <TextBlock HorizontalAlignment="Left" Margin="156,40,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="52" Width="281" FontSize="18"><Run Language="fr-fr" Text="Prachtige vaas! Doe een bod!"/></TextBlock>
        <Label Content="Naam: " HorizontalAlignment="Left" Margin="156,97,0,0" VerticalAlignment="Top" Height="30" Width="56" FontSize="14"/>
        <TextBox x:Name="inpNaam" HorizontalAlignment="Left" Margin="242,97,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="137" Height="30" FontSize="14"/>
        <Label Content="Bod: " HorizontalAlignment="Left" Margin="156,154,0,0" VerticalAlignment="Top" Height="30" Width="56" FontSize="14"/>
        <TextBox x:Name="inpBod" HorizontalAlignment="Right" Margin="0,146,421,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="99" Height="30" FontSize="14"/>
        <Button x:Name="btnBod" Content="Plaats Bod!" HorizontalAlignment="Left" Margin="280,202,0,0" VerticalAlignment="Top" Height="33" Width="99" Click="BtnBod_Click"/>
        <TextBlock x:Name="txtCom" HorizontalAlignment="Left" Margin="157,298,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Height="63" Width="406" FontSize="16"/>
        <Image Source="img/vaas.jpg" HorizontalAlignment="Left" Height="157" Margin="509,83,0,0" VerticalAlignment="Top" Width="182"/>


    </Grid>
</Window>
