<Window x:Class="WpfOxo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfOxo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Button x:Name="btn0" Click="Button_Click" FontSize="24" Grid.Row="0" Grid.Column="0"/>
        <Button x:Name="btn1" Click="Button_Click" FontSize="24" Grid.Row="0" Grid.Column="1"/>
        <Button x:Name="btn2" Click="Button_Click" FontSize="24" Grid.Row="0" Grid.Column="2"/>
        <Button x:Name="btn3" Click="Button_Click" FontSize="24" Grid.Row="1" Grid.Column="0"/>
        <Button x:Name="btn4" Click="Button_Click" FontSize="24" Grid.Row="1" Grid.Column="1"/>
        <Button x:Name="btn5" Click="Button_Click" FontSize="24" Grid.Row="1" Grid.Column="2"/>
        <Button x:Name="btn6" Click="Button_Click" FontSize="24" Grid.Row="2" Grid.Column="0"/>
        <Button x:Name="btn7" Click="Button_Click" FontSize="24" Grid.Row="2" Grid.Column="1"/>
        <Button x:Name="btn8" Click="Button_Click" FontSize="24" Grid.Row="2" Grid.Column="2"/>

        <TextBlock x:Name="txtResultaat" Grid.Row="3" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
    </Grid>
</Window>